{
  "name": "systemsense-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Dyad desktop investigator",
  "author": "Dyad contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests electron",
    "format": "prettier --write --end-of-line auto src tests electron scripts *.json *.ts *.mjs index.html",
    "format:check": "prettier --check --end-of-line auto src tests electron scripts *.json *.ts *.mjs index.html",
    "prepare:laya": "powershell -NoLogo -NoProfile -NonInteractive -File scripts/prepare-laya-setup.ps1",
    "package": "npm run prepare:laya && npm run build && electron-builder --win dir",
    "installer": "npm run prepare:laya && npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "org.systemsense.desktop",
    "productName": "Dyad",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "backend/dist/investigator",
        "to": "investigator"
      },
      {
        "from": "setup-assets",
        "to": "laya-setup"
      }
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/dyad.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/dyad.ico",
      "uninstallerIcon": "assets/dyad.ico"
    }
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.0",
    "resedit": "1.7.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
