{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemsense.local/schemas/reference-pack.v3.schema.json",
  "title": "SystemSense curated reference pack with explicit probe roles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "version", "title", "reviewed_at", "disclaimer", "sources", "nodes", "relations"],
  "properties": {
    "schema_version": {"const": 3},
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "reviewed_at": {"type": "string", "format": "date"},
    "disclaimer": {"type": "string", "minLength": 20, "maxLength": 1000},
    "sources": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/source"}},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/node"}},
    "relations": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "title", "publisher", "url", "usage_note"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^ks_[a-z0-9][a-z0-9_.-]{2,79}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 120},
        "url": {"type": "string", "pattern": "^https://", "maxLength": 500},
        "usage_note": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "category", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^kn_[a-z0-9][a-z0-9_.-]{2,119}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "category": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "kind": {"enum": ["subsystem", "condition", "mechanism", "symptom", "observation"]},
        "aliases": {"type": "array", "maxItems": 16, "items": {"type": "string"}}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "revision", "section", "license_id", "license_url", "pinned_url", "content_sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^ks_[a-z0-9][a-z0-9_.-]{2,79}$"},
        "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}(?:[0-9a-f]{24})?|v?[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?)$"},
        "section": {"type": "string", "minLength": 1, "maxLength": 240},
        "license_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,79}$"},
        "license_url": {"type": "string", "pattern": "^https://", "maxLength": 500},
        "pinned_url": {"type": "string", "pattern": "^https://", "minLength": 10, "maxLength": 500},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "probe_roles": {
      "type": "object", "additionalProperties": false,
      "required": ["screening_probe_ids", "discriminating_probe_ids", "unavailable_measurements"],
      "properties": {
        "screening_probe_ids": {"$ref": "#/$defs/probeIds"},
        "discriminating_probe_ids": {"$ref": "#/$defs/probeIds"},
        "unavailable_measurements": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      },
      "anyOf": [
        {"properties": {"screening_probe_ids": {"minItems": 1}}},
        {"properties": {"discriminating_probe_ids": {"minItems": 1}}},
        {"properties": {"unavailable_measurements": {"minItems": 1}}}
      ]
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "mechanism", "when", "symptoms", "probe_roles", "counter", "limits", "applies", "sources", "reviewed_at", "citations"],
      "properties": {
        "id": {"type": "string", "pattern": "^kr_[a-z0-9][a-z0-9_.-]{2,119}$"},
        "from": {"type": "string", "pattern": "^kn_[a-z0-9][a-z0-9_.-]{2,119}$"},
        "to": {"type": "string", "pattern": "^kn_[a-z0-9][a-z0-9_.-]{2,119}$"},
        "kind": {"enum": ["can_contribute_to", "can_present_as", "depends_on", "interacts_with", "distinguished_by"]},
        "mechanism": {"type": "string", "minLength": 12, "maxLength": 1000},
        "when": {"$ref": "#/$defs/nonemptyTextList"},
        "symptoms": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
        "probe_roles": {"$ref": "#/$defs/probe_roles"},
        "counter": {"$ref": "#/$defs/nonemptyTextList"},
        "limits": {"$ref": "#/$defs/nonemptyTextList"},
        "applies": {"$ref": "#/$defs/nonemptyTextList"},
        "sources": {"$ref": "#/$defs/nonemptyIdList"},
        "reviewed_at": {"type": "string", "format": "date"},
        "citations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/citation"}}
      }
    },
    "probeIds": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
    },
    "nonemptyTextList": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"type": "string", "minLength": 1}
    },
    "nonemptyIdList": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
